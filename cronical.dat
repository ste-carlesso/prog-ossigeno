# === Cronical.exe Global settings ===
# https://github.com/mgefvert/Cronical.git

ServiceChecks = 15              # Check services every x seconds, default is every second
Timeout       = 7200            # Jobs may run for up to x seconds



# === Jobs to run ===

# Il loggernet scarica nella prima cartella

# Alle 5, 6, 7, 8, 9, 10 invio a V2 (MainDataset, Dia) e poi sposto nella seconda cartella
00 5 * * * cmd /c D:\script_ossigeno\11_upload_to_V2.bat
00 6 * * * cmd /c D:\script_ossigeno\11_upload_to_V2.bat
00 7 * * * cmd /c D:\script_ossigeno\11_upload_to_V2.bat
00 8 * * * cmd /c D:\script_ossigeno\11_upload_to_V2.bat
00 9 * * * cmd /c D:\script_ossigeno\11_upload_to_V2.bat
00 10 * * * cmd /c D:\script_ossigeno\11_upload_to_V2.bat

